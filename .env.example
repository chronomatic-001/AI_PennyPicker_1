# AI PennyPicker - Environment Configuration
# Backend values also live in backend/.env.example. Do not commit real .env files.

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI — AGENT_MODEL resolved p4-t1: cheapest official function-calling model (gpt-5.4-nano, $0.20/$1.25 per 1M).
AGENT_MODEL=gpt-5.4-nano
OPENAI_API_KEY=

# Circle developer-controlled wallets
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=

# Gateway / seller config
SELLER_ADDRESS=
GATEWAY_FUND_TARGET_USDC=150
BUYER_PRIVATE_KEY=
# Circle Gateway batching floor (7d + 100s). Human-approved p3-t1 default.
SWEEP_AUTH_VALIDITY_SECONDS=604900

# Demo Settings
EVENT_B_TRIGGER_DELAY_MS=3000
SETTLEMENT_POLL_MS=30000

# Arc Testnet Configuration, verified 2026-06-21 from docs.arc.io and Circle docs
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_BASE=https://testnet.arcscan.app
USDC_ADDRESS=0x3600000000000000000000000000000000000000
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# Deployed Contracts
PENNYVAULT_ADDRESS=
MQQQ_ADDRESS=
OPERATOR_PRIVATE_KEY=
